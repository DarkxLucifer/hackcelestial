# =============================================================================
# YATAR Travel Resilience Engine - .gitignore
# =============================================================================

# Virtual Environments (Strictly ignored)
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
*.venv

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Node dependencies & caches
node_modules/
frontend/node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# Environment variables, credentials, and secrets
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key
*.log

# OS & IDE specific artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
*.db
*.sqlite3

# Large dataset files (exceeds GitHub 100MB limit)
flights.csv


