# ==============================================================================
# VOYAGE / YATAR RESILIENCE PLATFORM — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and insert your API keys
# ==============================================================================

# 1. MAPS & GEOSPATIAL
# Carto Basemaps API Key (https://carto.com/basemaps/apikey/)
VITE_CARTO_API_KEY=your_carto_api_key_here

# 2. AI DUAL-PROVIDER (GROQ + GEMINI LANGGRAPH FALLBACK)
# Groq API Key: Llama 3.3 70B Versatile (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key: Gemini 2.0 Flash / 1.5 Flash (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. FLIGHT TELEMETRY (AVIATIONSTACK)
# AviationStack API Key: Real-time flights, gates & delays (https://aviationstack.com/dashboard)
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# 4. TRAIN TELEMETRY (RAILRADAR & IRCTC)
# RailRadar Live Telemetry API Key (https://railradar.in/api)
RAILRADAR_API_KEY=your_railradar_api_key_here

# 5. BUS & ROAD RECOVERY (REDBUS & ABHIBUS SCRAPING / PARTNER API)
# Optional redBus / AbhiBus partner access token or proxy configuration
REDBUS_API_KEY=your_redbus_key_here
ABHIBUS_API_KEY=your_abhibus_key_here

# 6. URBAN TRANSIT (GTFS 2.0 FEEDS)
# GTFS Transit Feed URL (https://gtfs.org)
GTFS_STATIC_FEED_URL=https://openmobilitydata.org/
